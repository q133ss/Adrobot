# --- Keitaro tracker ---
# Адрес трекера без завершающего слэша.
# Для локальной демонстрации на фейковом трекере: http://127.0.0.1:8001 (см. `make fake`)
KEITARO_BASE_URL=http://127.0.0.1:8001
# Ключ: Keitaro admin -> Maintenance -> Users -> Admin API keys -> Documentation.
KEITARO_API_KEY=demo-api-key
KEITARO_TIMEOUT=20
# Отключите проверку TLS, если трекер работает с самоподписанным сертификатом.
KEITARO_VERIFY_SSL=true

# Встроенный фейковый трекер (in-process). Удобно, чтобы посмотреть интерфейс
# без реального Keitaro: KEITARO_DEMO=true make run
KEITARO_DEMO=false

# --- Application ---
APP_NAME=Adrobot
DEBUG=false
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./adrobot.db
# Создавать таблицы на старте, если миграции ещё не применены.
AUTO_CREATE_SCHEMA=true
CACHE_TTL_SECONDS=300

# Куда редиректит первый поток ("на гугл").
GOOGLE_REDIRECT_URL=https://www.google.com/
# Режим гео-фильтра по умолчанию для первого потока:
#   reject — на Google уходит всё, что вне списка гео (рекомендуемый, рабочий вариант);
#   accept — на Google уходит трафик из списка гео (буквально по тексту ТЗ).
DEFAULT_GEO_FILTER_MODE=reject
